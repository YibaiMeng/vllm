+
+    // Compile
+    const auto kernel = jit->compile("sm107_fp8_fp4_mega_moe", std::format(R"(
+#include <deep_gemm/impls/sm107_fp8_fp4_mega_moe.cuh>
+
+using namespace deep_gemm;
+
+static void __instantiate_kernel() {{
