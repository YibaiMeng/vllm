+        shared_block_k, config.load_block_m,
+        static_cast<int>(shared_l2_acts.stride(-2)),
+        shared_swizzle) : tensor_map_l2_acts;
+    const auto tensor_map_shared_l2_acts_sf = num_shared_experts > 0 ? make_tma_sf_desc(
